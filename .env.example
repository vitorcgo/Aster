# Copie este arquivo para .env e preencha a chave no servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Nível de raciocínio do agente: minimal, low, medium ou high
GEMINI_THINKING=low
# Último recurso quando a fila inteira falha (vazio desliga)
GEMINI_LAST_RESORT=gemini-3.5-flash-lite
# Chaves opcionais de outros provedores (também podem ser guardadas pelo painel de modelos)
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Perguntas permitidas por IP a cada minuto (0 desliga o limite)
ASTER_PERGUNTAS_POR_MINUTO=12
