# Tudo aqui é opcional. O Aster se configura pelo navegador:
# - cada visitante cola a própria chave em Modelos de IA (fica só no navegador dele);
# - o dono do site define limites e, se quiser, uma chave do site em Modelos de IA > Sou o dono do site.
# Estas variáveis só valem como reserva do que não foi definido no painel.

# Chave do site para quem não tiver a própria
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Fila padrão do Gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_LAST_RESORT=gemini-4-hydrogen

# Limites (0 desliga) e tempo máximo de uma pergunta
ASTER_PERGUNTAS_POR_MINUTO=12
ASTER_PERGUNTAS_POR_DIA=80
ASTER_PERGUNTAS_POR_DIA_TOTAL=1500
ASTER_TEMPO_MAXIMO=90

# Chave de cifra das chaves do site (sem ela, o Aster cria data/secret.key)
ASTER_SECRET=
